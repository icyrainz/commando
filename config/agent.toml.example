# Commando Agent Configuration
# Copy to /etc/commando/agent.toml and set chmod 600 root:root
# Validate with: commando-agent --check-config --config /etc/commando/agent.toml

bind = "0.0.0.0"           # Bind to all interfaces (or restrict to a LAN IP)
port = 9876
shell = "sh"               # or "bash", "fish"
psk = "REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32"
max_output_bytes = 131072  # 128KB cap for the non-streaming exec RPC only (the gateway uses streaming)
max_concurrent = 8         # Max simultaneous exec calls
