# Commando Gateway Configuration
# Copy to /etc/commando/gateway.toml and set chmod 600 root:root
# Validate with: commando-gateway --check-config --config /etc/commando/gateway.toml

# MCP server transport: "streamable-http" (HTTP, default) or "stdio" (stdin/stdout)
# [server]
# transport = "streamable-http"
# bind = "0.0.0.0"
# port = 9877

# Optional: Proxmox auto-discovery (omit this section for manual-only setup)
# [proxmox]
# nodes = [
#     { name = "node-1", host = "192.168.1.10", port = 8006 },
# ]
# user = "root@pam"
# token_id = "commando"
# token_secret = "REPLACE_WITH_PROXMOX_API_TOKEN"
# discovery_interval_secs = 60

# Output paging and back-pressure
# [streaming]
# page_timeout_secs = 5
# page_max_bytes = 32768
# session_idle_timeout_secs = 60
# Bytes a session may buffer before the gateway holds back the agent's output
# stream until the client polls. Must be at least page_max_bytes.
# session_buffer_max_bytes = 8388608  # 8 MiB

[agent]
default_port = 9876
default_timeout_secs = 300
connect_timeout_secs = 5
max_concurrent_per_target = 4

[agent.psk]
# my-target = "output-of-openssl-rand-hex-32"

# [[targets]]
# name = "my-target"
# host = "192.168.1.50"
# port = 9876
# shell = "sh"
# tags = ["web"]
